# ─────────────────────────────────────────────
# HeritageLens — Environment Variables
# Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local" to git.
# ─────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# AI Heritage Guide — LLM provider
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: Mapbox / Maptiler token for the Heritage Map
NEXT_PUBLIC_MAP_TOKEN=your-map-token

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
